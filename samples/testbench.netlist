# 1. Engine Directives
SIM_TIME 100

# 2. Topology Definition
WIRE Data_Line
WIRE Write_Enable
WIRE Memory_Bus
WIRE Inverted_Bus

# 3. Testbench Stimulus (No Java Code Needed!)
STIMULUS 0 Data_Line 1
STIMULUS 0 Write_Enable 0
STIMULUS 20 Write_Enable 1
STIMULUS 50 Data_Line 0
STIMULUS 80 Write_Enable 0

# 4. Hardware Components
BUFFER mem_ctrl 5 Data_Line Write_Enable Memory_Bus
NOT inverter1 5 Memory_Bus Inverted_Bus